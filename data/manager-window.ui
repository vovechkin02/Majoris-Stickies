<?xml version='1.0' encoding='utf-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  <requires lib="Adw" version="1.0" />
  <template class="StickiesManagerWindow" parent="AdwApplicationWindow">
    <property name="title">Stickies</property>
    <property name="default-width">890</property>
    <property name="default-height">620</property>
    <property name="content">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="title-widget">
              <object class="AdwWindowTitle">
                <property name="title">Stickies</property>
                <property name="subtitle">All Notes</property>
              </object>
            </property>
            <child type="end">
              <object class="GtkButton" id="new_button">
                <property name="icon-name">list-add-symbolic</property>
                <property name="tooltip-text">New Note (Ctrl+N)</property>
                <accessibility>
                  <property name="label">Create a new sticky note</property>
                </accessibility>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="screenshot_button">
                <property name="icon-name">camera-photo-symbolic</property>
                <property name="tooltip-text">New Note from Screenshot (Ctrl+Shift+S)</property>
                <accessibility>
                  <property name="label">Create a note from screenshot</property>
                </accessibility>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton" id="arrange_button">
                <property name="icon-name">view-grid-symbolic</property>
                <property name="tooltip-text">Arrange Note Windows</property>
                <accessibility>
                  <property name="label">Arrange open note windows</property>
                </accessibility>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="AdwToastOverlay" id="toast_overlay">
            <property name="child">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">0</property>
                <child>
                  <object class="GtkBox">
                    <property name="margin-start">18</property>
                    <property name="margin-end">18</property>
                    <property name="margin-top">16</property>
                    <property name="margin-bottom">12</property>
                    <child>
                      <object class="GtkSearchEntry" id="search_entry">
                        <property name="hexpand">True</property>
                        <property name="placeholder-text">Search notes</property>
                        <property name="tooltip-text">Search note titles and text</property>
                        <accessibility>
                          <property name="label">Search note titles, text, and source URLs</property>
                        </accessibility>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="spacing">8</property>
                    <property name="margin-start">18</property>
                    <property name="margin-end">18</property>
                    <property name="margin-bottom">12</property>
                    <child>
                      <object class="GtkDropDown" id="status_filter">
                        <property name="tooltip-text">All notes, Archive, or Trash</property>
                        <accessibility>
                          <property name="label">Select active, archived, or trashed notes</property>
                        </accessibility>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="color_filter">
                        <property name="tooltip-text">Filter notes by color</property>
                        <accessibility>
                          <property name="label">Filter notes by color</property>
                        </accessibility>
                      </object>
                    </child>
                    <child>
                      <object class="GtkDropDown" id="sort_dropdown">
                        <property name="tooltip-text">Sort notes</property>
                        <accessibility>
                          <property name="label">Sort notes by date, title, or color</property>
                        </accessibility>
                      </object>
                    </child>
                    <child>
                      <object class="GtkToggleButton" id="list_toggle">
                        <property name="icon-name">view-list-symbolic</property>
                        <property name="tooltip-text">Switch between grid and list views</property>
                        <accessibility>
                          <property name="label">Toggle list view</property>
                        </accessibility>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="count_label">
                        <property name="hexpand">True</property>
                        <property name="halign">end</property>
                        <property name="label">0 notes</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="vexpand">True</property>
                    <property name="hscrollbar-policy">never</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">10</property>
                        <property name="margin-start">18</property>
                        <property name="margin-end">18</property>
                        <property name="margin-bottom">18</property>
                        <child>
                          <object class="GtkLabel" id="empty_label">
                            <property name="label">No notes yet. Create your first note with the + button.</property>
                            <property name="halign">center</property>
                            <property name="valign">center</property>
                            <property name="margin-top">48</property>
                            <property name="wrap">True</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkFlowBox" id="notes_flow">
                            <property name="selection-mode">none</property>
                            <property name="homogeneous">True</property>
                            <property name="column-spacing">12</property>
                            <property name="row-spacing">12</property>
                            <property name="min-children-per-line">1</property>
                            <property name="max-children-per-line">3</property>
                            <property name="halign">fill</property>
                            <property name="valign">start</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="load_more_button">
                            <property name="label">Load More Notes</property>
                            <property name="halign">center</property>
                            <property name="visible">False</property>
                            <property name="tooltip-text">Show the next 60 matching notes</property>
                            <accessibility>
                              <property name="label">Load more matching notes</property>
                            </accessibility>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>