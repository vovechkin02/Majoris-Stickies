<?xml version='1.0' encoding='utf-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  <requires lib="Adw" version="1.0" />
  <template class="StickiesNoteWindow" parent="AdwApplicationWindow">
    <property name="title">Note — Stickies</property>
    <property name="default-width">370</property>
    <property name="default-height">330</property>
    <property name="content">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <child type="start">
              <object class="GtkButton" id="manager_button">
                <property name="icon-name">view-list-symbolic</property>
                <property name="tooltip-text">All Notes</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton" id="color_button">
                <property name="icon-name">applications-graphics-symbolic</property>
                <property name="tooltip-text">Note Color</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="screenshot_button">
                <property name="icon-name">camera-photo-symbolic</property>
                <property name="tooltip-text">Attach Screenshot</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="duplicate_button">
                <property name="icon-name">edit-copy-symbolic</property>
                <property name="tooltip-text">Duplicate Note</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkButton" id="delete_button">
                <property name="icon-name">user-trash-symbolic</property>
                <property name="tooltip-text">Delete Note</property>
              </object>
            </child>
            <child type="end">
              <object class="GtkMenuButton" id="more_button">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="tooltip-text">Note Options</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="GtkBox" id="paper_box">
            <property name="orientation">vertical</property>
            <property name="spacing">8</property>
            <property name="margin-start">0</property>
            <property name="margin-end">0</property>
            <child>
              <object class="GtkEntry" id="title_entry">
                <property name="placeholder-text">Note title</property>
                <property name="max-length">160</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <property name="margin-top">12</property>
                <property name="hexpand">True</property>
                <property name="has-frame">False</property>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">automatic</property>
                <property name="vscrollbar-policy">never</property>
                <property name="min-content-height">38</property>
                <child>
                  <object class="GtkBox" id="format_toolbar">
                    <property name="spacing">2</property>
                    <property name="margin-start">10</property>
                    <property name="margin-end">10</property>
                    <child>
                      <object class="GtkButton" id="bold_button">
                        <property name="label">B</property>
                        <property name="tooltip-text">Bold (Ctrl+B)</property>
                        <style>
                          <class name="flat" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="italic_button">
                        <property name="label">I</property>
                        <property name="tooltip-text">Italic (Ctrl+I)</property>
                        <style>
                          <class name="flat" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="underline_button">
                        <property name="label">U</property>
                        <property name="tooltip-text">Underline (Ctrl+U)</property>
                        <style>
                          <class name="flat" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="strike_button">
                        <property name="label">S̶</property>
                        <property name="tooltip-text">Strikethrough</property>
                        <style>
                          <class name="flat" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="mono_button">
                        <property name="label">M</property>
                        <property name="tooltip-text">Monospace font</property>
                        <style>
                          <class name="flat" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="large_button">
                        <property name="label">A+</property>
                        <property name="tooltip-text">Larger font</property>
                        <style>
                          <class name="flat" />
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="small_button">
                        <property name="label">A−</property>
                        <property name="tooltip-text">Smaller font</property>
                        <style>
                          <class name="flat" />
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow">
                <property name="vexpand">True</property>
                <property name="hscrollbar-policy">never</property>
                <child>
                  <object class="GtkTextView" id="body_view">
                    <property name="wrap-mode">word-char</property>
                    <property name="left-margin">12</property>
                    <property name="right-margin">12</property>
                    <property name="top-margin">4</property>
                    <property name="bottom-margin">4</property>
                    <property name="accepts-tab">True</property>
                    <property name="tooltip-text">Note text, saved automatically</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="source_button">
                <property name="label">Open Source</property>
                <property name="icon-name">web-browser-symbolic</property>
                <property name="tooltip-text">Open linked source website</property>
                <property name="halign">start</property>
                <property name="margin-start">12</property>
                <property name="visible">False</property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="attachments_box">
                <property name="orientation">vertical</property>
                <property name="spacing">4</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="save_label">
                <property name="label">Saved</property>
                <property name="halign">end</property>
                <property name="margin-end">14</property>
                <property name="margin-bottom">10</property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>